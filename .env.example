# Copy to .env (it is in .gitignore). Needed from step 3.
LLM_PROVIDER=openai-compatible   # openai-compatible | anthropic | mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=1024
RUN_TOKEN_BUDGET=300000      # tokens (input + output) per run; --budget overrides
DEEPSEEK_API_KEY=         # for --provider=deepseek
